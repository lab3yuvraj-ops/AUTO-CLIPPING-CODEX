# YouTube public lookup does not require an API key.
YOUTUBE_COOKIE_FILE=
# Optional; OFF when blank. Ties YouTube requests to your browser account.
YOUTUBE_COOKIES_FROM_BROWSER=
YOUTUBE_REQUEST_DELAY_SECONDS=2
# Total caption retry wait cap; Retry-After is never shortened to fit it.
CAPTION_RETRY_WAIT_CAP_SECONDS=300
# Optional experimental parallel downloader; requires local aria2c.
PARALLEL_DOWNLOADS=false
MIN_SOURCE_HEIGHT=1080
QUALITY_WAIT_HOURS=24
MAX_SOURCE_SECONDS=7200
# Connected Instagram account in Zernio
ZERNIO_API_KEY=
ZERNIO_INSTAGRAM_ID=
# Local speech models; HF token only for initial gated model downloads
WHISPER_MODEL=small
# Beam 1 did not meet the measured agreement gate; keep 5 by default.
FAST_WHISPER_BEAM_SIZE=5
WHISPER_BEAM_SIZE=5
LOCAL_DEVICE=cpu
LOCAL_COMPUTE_TYPE=int8
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
HF_TOKEN=
# Reviewed full subject bounds must fit inside the crop with this margin.
CROP_SAFETY_MARGIN=0.04
# Normalized horizontal subject movement needed to add a scene pan.
SCENE_PAN_THRESHOLD=0.08
# Minimum target width relative to independently reviewed full visible subject.
MIN_SUBJECT_WIDTH_FRACTION=1.0

# Selection-only fallback; selected verification remains small/beam5.
SELECTION_DRAFT_MODEL=base
FULL_DOWNLOAD_MAX_BYTES=1500000000
SECTION_DOWNLOAD_MIN_HEIGHT=2160
COMPACT_PRE_REVIEW=true
MOTION_CHECK_INTERVAL=0.1

# Performance branch: shared pipeline profiles; caption uncertainty --fast is separate.
PROCESSING_MODE=smart
ADAPTIVE_DETAILS=true
# Keep legacy renderer until comparing your own CPU/source. Direct is optional.
RENDER_BACKEND=legacy
X264_PRESET=fast
# Optional vision endpoint, OFF by default. Local CPU server example:
# SEMANTIC_VISION_URL=http://localhost:8080/v1/chat/completions
SEMANTIC_VISION_URL=
SEMANTIC_VISION_MODEL=
SEMANTIC_VISION_API_KEY=
# Sending frames/transcript to a remote endpoint requires explicit HTTPS opt-in.
SEMANTIC_ALLOW_REMOTE=false

# Optional: defer full-quality transfer until selection; same single fallback.
DOWNLOAD_MODE=auto
TRANSCRIPT_FIRST=true
SINGLE_PASS_REVIEW=true
